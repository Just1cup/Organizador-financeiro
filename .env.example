POSTGRES_DB=fluxo
POSTGRES_USER=fluxo
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://fluxo:change-me@postgres:5432/fluxo

# Gere com: openssl rand -hex 32 (a API se recusa a iniciar com o valor de exemplo abaixo)
SESSION_SECRET=replace-with-at-least-32-random-characters
INTERNAL_TOKEN=replace-with-another-random-secret

ADMIN_PASSWORD=
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_TEXT_MODEL=qwen3:8b
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# Obrigatório, em centavos (ex.: 370000 = R$ 3.700,00) — não há valor padrão de fábrica.
MONTHLY_SALARY_CENTS=

APP_TIME_ZONE=America/Sao_Paulo

# Nome/IP usado por Caddy (TLS) e pela API (lista branca de CORS). Se acessar por outro
# aparelho na rede local, defina o IP ou hostname reservado da máquina, não "localhost".
APP_HOST=localhost

API_ORIGIN=http://api:3000
VITE_API_URL=/api
